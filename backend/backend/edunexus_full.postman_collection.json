    "item": [
      {
        "name": "Register User",
        "request": {
          "method": "POST",
          "header": [{ "key": "Content-Type", "value": "application/json" }],
          "url": { "raw": "http://127.0.0.1:8000/api/users/" },
          "body": {
            "mode": "raw",
            "raw": "{\n  \"username\": \"ali\",\n  \"email\": \"ali@example.com\",\n  \"password\": \"mypassword123\"\n}"
          }
        }
      },
